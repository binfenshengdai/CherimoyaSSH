{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cherimoya-ssh",
  "version": "1.0.7",
  "identifier": "com.sundae.cherimoya-ssh",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cherimoya SSH",
        "width": 1200,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ5MTdENEJFRTcwRkQyOTUKUldTVjBnL252dFFYU2J1M3R2Y0V3OGJMY2UxbmtXalFiUkZwVFhPaWYrVmZGMzNtRnhSd3Y2ZWUK",
      "endpoints": [
        "https://github.com/binfenshengdai/CherimoyaSSH/releases/latest/download/latest-{{target}}.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
